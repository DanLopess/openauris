{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build OpenAuris",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "-project", "openauris.xcodeproj",
        "-scheme", "openauris",
        "-destination", "platform=macOS",
        "-configuration", "Debug",
        "-derivedDataPath", ".build",
        "build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Run OpenAuris",
      "type": "shell",
      "dependsOn": "Build OpenAuris",
      "command": "open",
      "args": [
        ".build/Build/Products/Debug/openauris.app"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "xcodebuild",
      "args": [
        "-project", "openauris.xcodeproj",
        "-scheme", "openauris",
        "-destination", "platform=macOS",
        "-configuration", "Debug",
        "-derivedDataPath", ".build",
        "-only-testing:openaurisTests",
        "test"
      ],
      "group": "test"
    }
  ]
}
